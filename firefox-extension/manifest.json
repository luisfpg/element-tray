{
  "manifest_version": 3,
  "name": "Element Tray Notifier",
  "version": "1.4",
  "browser_specific_settings": {
    "gecko": {
      "id": "element-tray-notifier@localhost"
    }
  },
  "permissions": ["tabs"],
  "host_permissions": ["http://127.0.0.1:45678/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://app.element.io/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}